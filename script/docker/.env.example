# Copy to .env and replace every CHANGE_ME value. Never commit the real .env.
ZBM_IMAGE_TAG=dev
DOCKER_EXTERNAL_NETWORK=common-net
ZBM_BACKEND_DIR=/opt/zbm/backend
ZBM_FRONTEND_DIR=/opt/zbm/frontend
BACKEND_PORT=8080
FRONTEND_PORT=8088
ZBM_PUBLIC_URL=http://localhost:8088

SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseZGC -XX:+HeapDumpOnOutOfMemoryError

ZBM_DB_HOST=jdpm-mysql
ZBM_DB_PORT=3306
ZBM_DB_NAME=zbm_dev_v1
ZBM_DB_USERNAME=CHANGE_ME
ZBM_DB_PASSWORD=CHANGE_ME

ZBM_REDIS_HOST=jdpm-redis
ZBM_REDIS_PORT=6379
ZBM_REDIS_DATABASE=0
ZBM_REDIS_PASSWORD=CHANGE_ME

# Writable container directory used by Spring multipart uploads.
ZBM_MULTIPART_LOCATION=/app/temp
ZBM_JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE

# Optional: configure only when the corresponding social login is enabled.
ZBM_JUSTAUTH_MAXKEY_SERVER_URL=
ZBM_JUSTAUTH_MAXKEY_CLIENT_ID=
ZBM_JUSTAUTH_MAXKEY_CLIENT_SECRET=
ZBM_JUSTAUTH_GITEE_CLIENT_ID=
ZBM_JUSTAUTH_GITEE_CLIENT_SECRET=

# true: empty database runs V1; managed database validates and runs newer migrations.
# Never enable against a non-empty unmanaged database such as legacy zbm-data.
ZBM_FLYWAY_ENABLED=true

# Set these values when customer sensitive-data security is enabled.
ZBM_CUSTOMER_SECURITY_ENABLED=false
ZBM_FIELD_ENCRYPT_ENABLED=false
ZBM_CUSTOMER_FIELD_ENCRYPT_KEY=
ZBM_CUSTOMER_IDENTITY_HMAC_KEY=
ZBM_CUSTOMER_PII_KEY_VERSION=
